WORK_LIMIT = 1             # issues moved forward per pass: each step is a model run or an orchestrator run
IN_PROGRESS_LIMIT = 2      # issues approved or being coded at once
RED_TIMEOUT = 600          # seconds per acceptance command in the red check
DRIVE_TIMEOUT = 6 * 3600
ALWAYS_BLOCKED = (".github/workflows/**", "**/.env*", "**/*.pem", "**/*.key", "**/secrets/**")
SEED_POLICY = {"kennylhilljr/ecc-customization": ["bootstrap.sh", "stack.conf", "machine/**"]}
BUDGET_CAPS = {"attempts": 3, "minutes": 60, "maximum_cost_usd": 5}
DENY_COMMANDS = (r"\bcurl\b", r"\bwget\b", r"\bssh\b", r"\bscp\b", r"\bsudo\b", r"\bgit\s+push\b", r"(^|[\s;&|(])gh\s",
                 r"\bprbot\b", r"\|\s*(ba|z)?sh\b", r"\bnc\b", r"\bsecurity\b", r"\b(pip3?|npm|brew)\s+install\b")
G_MARKER = "<!-- iwb:gates -->"
V_MARKER = "<!-- iwb:approval -->"
W_MARKER = "<!-- iwb:work -->"
