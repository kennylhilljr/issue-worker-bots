class WorkError(Exception):
    """A step of the coding run failed in a way that needs Kenny: the issue is blocked with this reason."""


def glob_rx(pattern):
    """Path glob as a regex: ** crosses directories, * and ? stay inside one. **/x also matches x at the root."""
    out, i = "", 0
    while i < len(pattern):
        if pattern.startswith("**/", i):
            out, i = out + "(?:.*/)?", i + 3
        elif pattern.startswith("**", i):
            out, i = out + ".*", i + 2
        elif pattern[i] == "*":
            out, i = out + "[^/]*", i + 1
        elif pattern[i] == "?":
            out, i = out + "[^/]", i + 1
        else:
            out, i = out + re.escape(pattern[i]), i + 1
    return re.compile(r"\A" + out + r"\Z", re.I)


def clean_path(f):
    """The path relative to the repository root, or None when it points outside it."""
    p = f.strip()
    while p.startswith("./"):
        p = p[2:]
    if not p or p.startswith("/") or "\\" in p or ".." in p.split("/"):
        return None
    return p



class Stopped(Exception):
    """Kenny stopped a running drive (bot:stop or paused). Not a failure: the issue stays resumable."""


def ecc_path():
    """The orchestrator CLI: config.json "ecc_path" (for example a worktree kept at origin/main), else ECC."""
    p = read_config().get("ecc_path")
    return Path(os.path.expanduser(p)) if p else ECC


TOKENISH = re.compile(r"(?i)\b(?:gh[pousr]_\w{16,}|github_pat_\w{16,}|sk-[\w-]{16,}|xox[abpr]-[\w-]{10,}|"
                      r"AKIA[A-Z0-9]{16}|eyJ[\w-]{8,}\.[\w-]{8,}\.[\w-]*|bearer\s+\S{8,})"
                      r"|(?:token|key|secret|password)[\"']?\s*[:=]\s*[\"']?[^\s\"']{8,}|\b[A-Za-z0-9+/_-]{32,}={0,2}")


def short(text, n=200):
    """Orchestrator output for a comment: token-shaped strings removed (prbot has no redaction helper), then cut."""
    t = TOKENISH.sub("[redacted]", " ".join(str(text).split()))
    return t if len(t) <= n else t[:n - 3] + "..."


def kill_group(p):
    """SIGTERM the process group (the orchestrator and every runner CLI it started), SIGKILL whatever is left."""
    try:
        os.killpg(p.pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    end = time.time() + KILL_GRACE
    while time.time() < end:
        if p.poll() is not None:
            try:
                os.killpg(p.pid, 0)
            except ProcessLookupError:
                return
        time.sleep(0.2)
    try:
        os.killpg(p.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    p.wait()


def run_ecc(args, timeout=900, env=None, watch=None):
    """Run the orchestrator CLI in its own process group. Every POLL seconds `watch` may return a reason to stop.
    On a stop (Stopped) or the timeout (WorkError) the whole group is killed first. Returns (exit code, JSON
    envelope or {}, stderr tail). Tests replace this."""
    argv = [str(ecc_path())] + args
    with tempfile.TemporaryFile("w+") as out, tempfile.TemporaryFile("w+") as err:
        p = subprocess.Popen(argv, stdout=out, stderr=err, stdin=subprocess.DEVNULL, text=True, env=env,
                             start_new_session=True)
        deadline = time.time() + timeout
        while True:
            try:
                p.wait(timeout=max(0.1, min(POLL, deadline - time.time())))
                break
            except subprocess.TimeoutExpired:
                pass
            why = "timeout" if time.time() >= deadline else watch() if watch else None
            if why:
                kill_group(p)
                if why == "timeout":
                    raise WorkError(f"`ecc {args[0]}` timed out after {timeout // 60} minutes")
                raise Stopped(why)
        out.seek(0)
        err.seek(0)
        stdout, stderr = out.read(), err.read()
    env = {}
    for chunk in (stdout, (stdout.strip().splitlines() or [""])[-1]):
        try:
            env = json.loads(chunk)
            break
        except ValueError:
            continue
    return p.returncode, env if isinstance(env, dict) else {}, (stderr or "").strip()[-500:]


def ecc_data(ecc, args, what, timeout=900, **kw):
    """The envelope's data when the command succeeded, else WorkError with the failed checks."""
    code, env, err = ecc(args, timeout, **kw)
    if code != 0:
        failed = [f"{c.get('name')}: {c.get('detail', '')}" for c in env.get("checks", []) if not c.get("ok")]
        stop = (env.get("data") or {}).get("stop")
        detail = "; ".join(([f"stopped: {stop}"] if stop else []) + failed) or err or "no output"
        raise WorkError(f"`ecc {what}` failed (exit {code}): {short(detail)}")
    return env.get("data") or {}


def drive_env():
    """The orchestrator's environment: what it and the runner CLIs need to find their own logins, nothing more.
    No GitHub tokens or other secrets: the run pushes nothing; iwb pushes as the worker bot afterwards."""
    keep = DRIVE_ENV + tuple(n for n in read_config().get("drive_env", []) if not SECRET_ENV.match(n))
    env = {k: os.environ[k] for k in keep if k in os.environ}
    user = pwd.getpwuid(os.getuid()).pw_name    # launchd sets no USER; Claude Code finds its keychain login by it
    env.setdefault("USER", user)
    env.setdefault("LOGNAME", user)
    env.setdefault("LANG", "en_US.UTF-8")
    env.setdefault("TMPDIR", tempfile.gettempdir())
    if env.get("PATH"):
        env["PATH"] = newest_first(env["PATH"], REQUIRED_RUNNERS)
    return env


def cli_version(exe):
    """The version tuple a runner CLI reports (`2.1.281 (Claude Code)`, `codex-cli 0.158.0`), or () if none."""
    try:
        out = subprocess.run([exe, "--version"], capture_output=True, text=True, timeout=30).stdout
    except (OSError, subprocess.SubprocessError):
        return ()
    m = re.search(r"(\d+(?:\.\d+)+)", out)
    return tuple(int(n) for n in m.group(1).split(".")) if m else ()


def newest_first(path, tools):
    """PATH with the directory of each tool's newest copy moved to the front. launchd's PATH (install-intake.sh)
    can list an old copy first, for example Claude Code 2.1.112 in ~/.local/bin ahead of 2.1.281, and the
    orchestrator's runner flags need the version it certified."""
    dirs = path.split(os.pathsep)
    for tool in tools:
        found = [d for d in dirs if d and os.access(os.path.join(d, tool), os.X_OK)]
        if len(found) > 1:
            best = max(found, key=lambda d: cli_version(os.path.join(d, tool)))   # first one wins a tie
            dirs = [best] + [d for d in dirs if d != best]
    return os.pathsep.join(dirs)


def cert_expiry(rec):
    """expires_at as epoch seconds, read the way the orchestrator's registry reads it (None: no expiry)."""
    try:
        t = datetime.datetime.fromisoformat(str(rec.get("expires_at")).replace("Z", "+00:00"))
    except ValueError:
        return None
    return (t if t.tzinfo else t.replace(tzinfo=datetime.timezone.utc)).timestamp()


def cert_problem(path, horizon):
    """Why the certifications can't carry a run lasting up to `horizon` seconds, or None. Records are read as the
    orchestrator reads them. The worker families must be certified, and no certified runner may expire before the
    run could end: it would drop out of routing half way through."""
    try:
        doc = json.loads(Path(path).read_text())
    except (OSError, ValueError) as e:
        return f"cannot read the orchestrator certifications at {path}: {e}"
    records = doc.get("records") if isinstance(doc, dict) else doc
    if records is None and isinstance(doc, dict) and isinstance(doc.get("results"), list):
        records = [r.get("record", r) if isinstance(r, dict) else r for r in doc["results"]]
    if not isinstance(records, list):
        return f"no certification records in {path}"
    until = time.time() + horizon
    certified = {r.get("runner"): r for r in records if isinstance(r, dict) and r.get("status") == "certified"}
    out = [f"{n} is not certified" for n in read_config().get("ecc_runners", REQUIRED_RUNNERS) if n not in certified]
    out += [f"{n} expires {r.get('expires_at')}" for n, r in sorted(certified.items())
            if cert_expiry(r) is not None and cert_expiry(r) <= until]
    return f"orchestrator certifications won't last the run ({'; '.join(out)})" if out else None


def orchestrator_drift():
    """Why the orchestrator checkout isn't at origin/main, or None. iwb runs whatever is checked out there, and
    Kenny's working checkout may sit on a feature branch. A clean main that is only behind is fast-forwarded."""
    repo = ecc_path().resolve().parent.parent
    git = lambda *a: subprocess.run(["git", "-C", str(repo), *a], capture_output=True, text=True, timeout=300)
    f = git("fetch", "-q", "origin")
    if f.returncode != 0:
        return f"could not fetch the orchestrator at {repo}: {f.stderr.strip()[-200:]}"
    head, main = (git("rev-parse", "--verify", "-q", ref).stdout.strip() for ref in ("HEAD", "origin/main"))
    if main and head != main and fast_forwardable(git, head, main):
        m = git("-c", "core.hooksPath=/dev/null", "merge", "-q", "--ff-only", main)
        if m.returncode == 0:
            log(f"orchestrator at {repo} fast-forwarded from {head[:10]} to origin/main ({main[:10]})")
        else:
            log(f"orchestrator at {repo} could not fast-forward: {m.stderr.strip()[-200:]}")
        head = git("rev-parse", "--verify", "-q", "HEAD").stdout.strip()
    if not main or head != main:
        return (f"the orchestrator at {repo} is at {head[:10] or '?'}, not origin/main ({main[:10] or '?'}); "
                f"update it or set ecc_path in config.json")
    return None


def fast_forwardable(git, head, main):
    """True when the orchestrator checkout is on branch main, has no changes to tracked files and is strictly
    behind origin/main, so a fast-forward only adds commits. Anything else is left for a person: iwb never
    resets, stashes or switches branches there."""
    return (bool(head) and git("symbolic-ref", "-q", "--short", "HEAD").stdout.strip() == "main"
            and git("status", "--porcelain", "--untracked-files=no").stdout.strip() == ""
            and git("merge-base", "--is-ancestor", head, main).returncode == 0)


def block(entry, bot, repo, number, title, body, problem):
    """Label bot:blocked, tell OpenClaw. Removing bot:blocked restarts the issue from analysis."""
    url = post(bot, repo, number, body + "\n\nRemove `bot:blocked` to start again from analysis.", "bot:blocked")
    entry["blocked"] = True
    entry["work"] = {**(entry.get("work") or {}), "status": "blocked", "at": time.time(), "comment": url,
                     "problem": problem[:300]}
    prbot.openclaw_attention(f"blocked: {repo}#{number}", {"url": url, "title": title, "problem": problem[:300]})
    log(f"{repo}#{number}: blocked ({problem[:120]}) {url}")


def slugify(title):
    return re.sub(r"[^a-z0-9]+", "-", title.lower()).strip("-")[:40].strip("-") or "issue"


def checkout(repo, bot, branch):
    """iwb's own clone of the target repository (never one of Kenny's checkouts), with the bot branch created at
    the default branch's tip. The orchestrator fast-forwards that branch; HEAD stays on the default branch.
    Returns (dir, default branch, base commit)."""
    default = gh_json(["api", f"repos/{repo}", "--jq", "{b: .default_branch}"])[0]["b"]
    d = WORK_DIR / "repos" / repo.replace("/", "__")
    shutil.rmtree(d, ignore_errors=True)
    d.parent.mkdir(parents=True, exist_ok=True)
    env = prbot.git_env(token=prbot.installation_token(bot, repo, permissions={"contents": "read"}))
    subprocess.run(["git", "clone", "-q", "--single-branch", "--branch", default, f"https://github.com/{repo}.git",
                    str(d)], env=env, check=True, capture_output=True, timeout=900)
    base = subprocess.run(["git", "-C", str(d), "rev-parse", "HEAD"], capture_output=True, text=True,
                          check=True).stdout.strip()
    subprocess.run(["git", "-C", str(d), "branch", branch, base], check=True, capture_output=True)
    team = d / ".orchestration" / "team.json"
    if not team.exists():
        # the plan approver stands in for Kenny: the orchestrator's agents approve merges into the bot branch of
        # this clone. Kenny still merges the PR. Kept out of git so it never reaches the PR. The plan was already
        # red-checked and approved by the other worker family, so the architect's milestone-start plan check is
        # skipped: it repeated that review, and when no architect answered it stopped the drive (no_architect).
        team.parent.mkdir(exist_ok=True)
        team.write_text(json.dumps(TEAM) + "\n")
        with open(d / ".git" / "info" / "exclude", "a") as f:
            f.write("\n/.orchestration/team.json\n")
    return str(d), default, base


# After a run, iwb's clone and everything in its .git (hooks, config, includes) is the agents' work and is never
# trusted again. The result is fetched into a new bare repository that iwb creates; git there reads no system,
# global or repository config but iwb's own, and runs no hooks. Only that repository ever sees a token.
RESULT_REF = "refs/iwb/result"
TRUSTED_GIT = ("-c", "core.hooksPath=/dev/null", "-c", "core.fsmonitor=false")
UNTRUSTED_GIT_ENV = ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE", "GIT_OBJECT_DIRECTORY", "GIT_CONFIG",
                     "GIT_ALTERNATE_OBJECT_DIRECTORIES", "GIT_CONFIG_PARAMETERS", "GIT_NAMESPACE")
GITHUB_REPO = re.compile(r"[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9._-]*[A-Za-z0-9_-][A-Za-z0-9._-]*\Z")
BOT_BRANCH = re.compile(r"bot/[A-Za-z0-9][A-Za-z0-9._-]*\Z")


def git_trusted(d, *args, env=None, timeout=600):
    """git in a repository iwb made, with no system or global config (HOME is writable by the run) and no hooks.
    `env` is from prbot.git_env, whose credential settings are command-line config and so still apply."""
    env = {k: v for k, v in (os.environ if env is None else env).items() if k not in UNTRUSTED_GIT_ENV}
    env.update(GIT_CONFIG_NOSYSTEM="1", GIT_CONFIG_GLOBAL=os.devnull, GIT_TERMINAL_PROMPT="0")
    r = subprocess.run(["git", *TRUSTED_GIT, "-C", str(d), *args], env=env, capture_output=True, text=True,
                       timeout=timeout)
    if r.returncode != 0:
        sub = next((a for a in args if not a.startswith("-") and "=" not in a), "?")
        raise WorkError(f"git {sub} failed: {short(r.stderr or r.stdout, 300)}")
    return r.stdout


def trusted_copy(d, branch, base):
    """A new bare repository holding the run's branch from `d` at RESULT_REF. The fetch runs git-upload-pack in
    `d`, which git keeps safe for untrusted repositories (no hooks, no commands from repository config), and no
    token is in its environment. The branch must start at `base`, the default branch tip cloned before the run."""
    clean = tempfile.mkdtemp(prefix="iwb-push-")
    try:
        git_trusted(clean, "init", "-q", "--bare", "--template=", ".")
        git_trusted(clean, "-c", "protocol.file.allow=always", "fetch", "-q", "--no-tags", "--no-write-fetch-head",
                    "--no-recurse-submodules", Path(d).resolve().as_uri(), f"+refs/heads/{branch}:{RESULT_REF}")
        try:
            git_trusted(clean, "merge-base", "--is-ancestor", base, RESULT_REF)
        except WorkError:
            raise WorkError(f"the run's branch doesn't start from the default branch at {base[:10]}") from None
    except BaseException:
        shutil.rmtree(clean, ignore_errors=True)
        raise
    return clean


def changed_files(d, base, ref):
    """Every path the run touched. --no-renames reports a rename as a delete and an add, so the scope and
    protected-path checks see the old path too (a rename otherwise lists only the new one). -z keeps unusual
    names unquoted. Only the empty piece after the last NUL is dropped: a file named " " is still a change."""
    out = git_trusted(d, "diff-tree", "-r", "--no-renames", "--name-only", "-z", base, ref)
    return [f for f in out.split("\0") if f]


def scope_problems(files, units, repo):
    """Changed files outside every unit's scope, or on a protected path. Checked again after the run."""
    scope = {clean_path(f) for u in units for f in u["scope"]["files"]}
    rules = path_rules(repo)
    out = [f"`{f}` is outside the plan's scope" for f in files if f not in scope]
    out += [f"`{f}` is a protected path" for f in files if protected(f, rules)]
    return out


def commit_as(bot, repo, d, base, ref, message):
    """One commit with the run's result, authored and committed by the worker bot (prbot's identity, no token)."""
    tree = git_trusted(d, "rev-parse", "--verify", f"{ref}^{{tree}}").strip()
    env = prbot.git_env(identity=prbot.bot_identity(bot))
    return git_trusted(d, "commit-tree", tree, "-p", base, "-m", message, env=env).strip()


def push_branch(bot, repo, d, sha, branch, default):
    """Push to bot/<n>-<slug>-<attempt> on https://github.com/<repo> only: never the default branch, never a
    remote name. The token is asked for here, after every check."""
    if branch == default or not BOT_BRANCH.match(branch):
        raise WorkError(f"refusing to push to `{branch}`: workers push only to bot/ branches")
    if not GITHUB_REPO.match(repo):
        raise WorkError(f"refusing to push to `{repo}`: not an owner/name GitHub repository")
    env = prbot.git_env(token=prbot.installation_token(bot, repo, permissions={"contents": "write"}),
                        identity=prbot.bot_identity(bot))
    git_trusted(d, "push", "-q", "--no-verify", f"https://github.com/{repo}.git", f"{sha}:refs/heads/{branch}",
                env=env)


def publish(bot, repo, d, base, branch, default, units, message):
    """Check the run's result and push it as one commit by the worker bot, all from a trusted copy (trusted_copy).
    Returns the pushed commit. WorkError when nothing changed or a file is outside the plan or protected."""
    clean = trusted_copy(d, branch, base)
    try:
        files = changed_files(clean, base, RESULT_REF)
        if not files:
            raise WorkError("the run finished without changing any file")
        problems = scope_problems(files, units, repo)
        if problems:
            raise WorkError("the run changed files the plan doesn't allow: " + "; ".join(problems))
        sha = commit_as(bot, repo, clean, base, RESULT_REF, message)
        push_branch(bot, repo, clean, sha, branch, default)
        return sha
    finally:
        shutil.rmtree(clean, ignore_errors=True)


def create_pr(bot, repo, branch, default, title, body, agent):
    """Draft PR with the agent label. Returns its URL."""
    try:
        run_gh_as(bot, repo, ["label", "create", f"agent:{agent}", "-R", repo, "--color", "BFD4F2",
                              "--description", f"Written by {agent}"])
    except RuntimeError:
        pass                        # the label already exists
    return run_gh_as(bot, repo, ["pr", "create", "-R", repo, "--draft", "--base", default, "--head", branch,
                                 "--title", title, "--body", body, "--label", f"agent:{agent}"])


def ready_pr(bot, repo, url):
    """Marked ready, so the prbot watcher reviews it."""
    run_gh_as(bot, repo, ["pr", "ready", url, "-R", repo])


def orchestrator_config(path):
    """Write the orchestrator config for a run: certifications and catalog by default, overridden or extended by
    config.json "ecc_config" (any orchestrator config key, for example repo_checks). RuntimeError if the
    certifications are missing or would expire before the run could end, since no runner could be assigned."""
    c = {**ECC_DEFAULTS, **read_config().get("ecc_config", {})}
    c = {k: os.path.expanduser(v) if isinstance(v, str) else v for k, v in c.items()}
    if not Path(c.get("certifications") or "").is_file():
        raise RuntimeError(f"no orchestrator certifications at {c.get('certifications')}; set ecc_config in config.json")
    problem = cert_problem(c["certifications"], DRIVE_TIMEOUT)
    if problem:
        raise RuntimeError(problem)
    if c.get("catalog") and not Path(c["catalog"]).is_file():
        c.pop("catalog")
    Path(path).write_text(json.dumps(c, indent=1) + "\n")
    return path


def stop_reason(repo, number):
    """Why a running drive must stop now, or None: the bots were paused, or the issue got bot:stop."""
    try:
        if read_config().get("paused"):
            return "the bots were paused"
        labels = gh_json(["api", f"repos/{repo}/issues/{number}", "--jq", "{labels: [.labels[].name]}"])[0]["labels"]
    except (SystemExit, ValueError, IndexError, KeyError):
        return None                 # a failed read is not a stop; the next poll asks again
    return "`bot:stop` was added" if "bot:stop" in labels else None


def code_plan(key, entry, issue, state, since, ecc):
    """Orchestrator run in iwb's own clone, one commit by the worker bot on a branch of its own, then a PR."""
    repo, number = key.rsplit("#", 1)
    owner, name = repo.split("/")
    (WORK_DIR / "repos").mkdir(parents=True, exist_ok=True)
    ecc_cfg = orchestrator_config(WORK_DIR / "repos" / f"{repo.replace('/', '__')}.ecc.json")   # before any post
    drift = orchestrator_drift()
    if drift:
        raise RuntimeError(drift)
    agent, w = entry["agent"], entry["work"]
    worker = WORKERS[agent]
    units = json.loads(Path(entry["plan_file"]).read_text())["units"]
    run_id = f"iwb.{owner}.{name}.{number}.{time.strftime('%Y%m%d%H%M%S', time.gmtime())}"
    branch = f"bot/{number}-{slugify(issue['title'])}-{hashlib.sha256(run_id.encode()).hexdigest()[:6]}"
    session = f"iwb.{repo.replace('/', '.')}.{number}"
    wslug = prbot.bot_config(worker)["slug"]
    url = post(worker, repo, number, f"{W_MARKER}\nPlan approved by `{w['approver']}`. Coding started on "
               f"`{branch}` (orchestrator run `{run_id}`).", "bot:in-progress")
    w.update(status="in-progress", branch=branch, run_id=run_id, started_at=time.time(), started_comment=url)
    save_state(state, since)        # a pass that dies mid-run leaves in-progress behind, which the next pass reports
    log(f"{key}: coding started, run {run_id}")
    try:
        d, default, base = checkout(repo, worker, branch)
        plan = str(Path(d).parent / f"{Path(d).name}.plan.json")
        Path(plan).write_text(json.dumps({"units": units}, indent=1) + "\n")
        cfg = ["--config", str(ecc_cfg), "--repo", d, "--target-branch", branch,
               "--state-dir", str(WORK_DIR / "ecc-state"), "--worktree-root", str(WORK_DIR / "worktrees")]
        opts = {"env": drive_env()}    # no sandbox-exec: codex can't write under one (DESIGN.md "Safety")
        approve = ["review-plan", "--json", "--approve", "--operator", w["approver"], "--session", session, "--"]
        create = ["create-run", "--run-id", run_id, "--plan", plan] + cfg
        review = ecc_data(ecc, approve + create, "review-plan create-run", **opts)
        w["plan_sha256"] = review.get("plan_sha256")
        ecc_data(ecc, create + ["--yes", "--review-id", review["review_id"], "--json"], "create-run", **opts)
        hours = max(1, -(-sum(u["budget"]["minutes"] for u in units) // 60))
        cost = read_config().get("max_cost_usd_per_issue", MAX_COST_USD)
        drive = ["drive", "--run-id", run_id, "--max-hours", str(hours), "--max-cost-usd", str(cost)] + cfg
        review = ecc_data(ecc, approve + drive, "review-plan drive", **opts)
        ecc_data(ecc, drive + ["--yes", "--review-id", review["review_id"], "--json"], "drive", DRIVE_TIMEOUT,
                 watch=lambda: stop_reason(repo, number), **opts)
        sha = publish(worker, repo, d, base, branch, default, units, f"{issue['title']} (#{number})\n\nCloses "
                      f"#{number}. Planned by {wslug}, approved by {w['approver']}, orchestrator run {run_id}.")
    except Stopped as e:
        w.update(status="stopped", stopped=str(e), at=time.time())
        try:
            run_gh_as(worker, repo, ["issue", "comment", number, "-R", repo, "--body",
                                     f"{W_MARKER}\nCoding stopped because {e} (run `{run_id}`). Nothing was pushed. "
                                     f"It starts again from the approved plan once that is undone."])
        except RuntimeError as err:
            log(f"{key}: could not post the stop note: {err}")
        log(f"{key}: coding stopped: {e}")
        return
    except (WorkError, RuntimeError, subprocess.SubprocessError, SystemExit, OSError, KeyError) as e:
        block(entry, worker, repo, number, issue["title"], f"{W_MARKER}\nCoding stopped: {short(e)}",
              f"coding: {short(e, 300)}")
        return
    rows = "\n".join(f"| `{u['id']}` | {u['title']} | {u['routing']['initial_tier']} |" for u in units)
    body = (f"Closes #{number}\n\nPlanned by `{wslug}` ({entry['analysis'].get('comment', '')}), approved by "
            f"`{w['approver']}` ({w.get('approval_comment', '')}), coded by orchestrator run `{run_id}`.\n\n"
            f"| Unit | What | Tier |\n| --- | --- | --- |\n{rows}\n\nKenny merges; the bots never do.")
    entry.setdefault("branches", []).append({"branch": branch, "sha": sha, "run_id": run_id,
                                             "plan_digest": w["plan_digest"], "at": time.time()})
    w.update(status="pushed", default=default, pr_body=body)
    save_state(state, since)        # pushed: a retry opens the PR from this branch and never pushes again
    finish_pr(key, entry, issue, state, since)


def finish_pr(key, entry, issue, state, since):
    """Open (or finish opening) the PR for the pushed branch, close the PRs of earlier attempts, label bot:pr-open.
    The PR URL is saved as soon as it exists. A GitHub failure here retries in an hour from the same branch."""
    repo, number = key.rsplit("#", 1)
    w, worker = entry["work"], WORKERS[entry["agent"]]
    rec = next(b for b in entry["branches"] if b["branch"] == w["branch"])
    try:
        if not rec.get("pr"):
            rec["pr"] = create_pr(worker, repo, w["branch"], w["default"], issue["title"], w["pr_body"], entry["agent"])
            save_state(state, since)
        if not rec.get("ready"):
            ready_pr(worker, repo, rec["pr"])
            rec["ready"] = True
    except RuntimeError as e:
        entry["work_failed_at"] = time.time()
        mark(key, "failed", f"pull request for `{w['branch']}` not finished; retrying in {RETRY_AFTER // 60} minutes: {e}")
        return
    for old in entry["branches"]:
        if old is not rec and old.get("pr") and not old.get("closed"):
            try:
                run_gh_as(worker, repo, ["pr", "close", old["pr"], "-R", repo, "--comment",
                                         f"Superseded by {rec['pr']}, a later attempt at #{number}."])
                old["closed"] = True
            except RuntimeError as e:
                log(f"{key}: could not close the earlier PR {old['pr']}: {e}")
    w["pr"] = rec["pr"]
    log(f"{key}: PR opened {rec['pr']}")
    try:
        w["comment"] = post(worker, repo, number, f"{W_MARKER}\nPull request opened and marked ready for review: "
                            f"{rec['pr']}", "bot:pr-open")
    except RuntimeError as e:       # still "pushed": the next try skips the steps above that are done
        entry["work_failed_at"] = time.time()
        mark(key, "failed", f"could not label the issue bot:pr-open; retrying in {RETRY_AFTER // 60} minutes: {e}")
        return
    w.update(status="pr-open", done_at=time.time())


def work_lock(name="work.lock"):
    """One step-4b pass at a time, so a manual `iwb code` never mistakes a running pass for an interrupted one.
    `tick.lock` does the same for the intake, analysis and approval part of `tick`, in both of its modes. None if
    another process holds the lock."""
    import fcntl
    WORK_DIR.mkdir(parents=True, exist_ok=True)
    f = open(WORK_DIR / name, "w")
    try:
        fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        f.close()
        return None
    return f


PLAN_ERRORS = (OSError, ValueError, KeyError, TypeError)   # a plan file that is missing, unreadable or malformed


def approved_plan(entry):
    """(approval record, units) when main's step 4a approved the plan file as it is now, else (None, None). Raises
    one of PLAN_ERRORS when an approved plan's file is missing or malformed: that needs attention, not silence."""
    ap = entry.get("approval") or {}
    if ap.get("verdict") != "approve" or not entry.get("plan_file"):
        return None, None
    units = json.loads(Path(entry["plan_file"]).read_text())["units"]
    return (ap, units) if ap.get("plan_digest") == plan_digest(units) else (None, None)


def needs_coding(entry):
    """Whether step 4b has anything to do for this state entry: a plan step 4a approved as it is now, not yet turned
    into a PR or blocked. cmd_code decides the rest; this keeps other issues out of coding waits and hand-offs.
    Raises one of PLAN_ERRORS when the plan file can't be read; callers treat that as a failure of that issue."""
    if not isinstance(entry, dict) or entry.get("blocked") or entry.get("closed") or entry.get("stale_plan") \
            or (entry.get("analysis") or {}).get("decision") != "plan":
        return False
    ap, _ = approved_plan(entry)
    if not ap:
        return False
    w = entry.get("work") or {}
    return not (w.get("plan_digest") == ap["plan_digest"] and w.get("status") in ("pr-open", "blocked"))


def cmd_code(dry_run=False, limit=CODE_LIMIT, ecc=None, only=None):
    """Step 4b: code plans that step 4a approved, in repositories listed in config.json "coding_repos"."""
    ecc = ecc or run_ecc
    conf = read_config()
    if conf.get("paused"):
        log("paused in config.json; no coding")
        return 0
    lock = work_lock()
    if lock is None:
        log("another coding pass is running; skipping")
        if only:                          # only issues that have coding to do wait for the lock
            state = read_state_file()
            for key in only:
                try:
                    if needs_coding(state.get(key)):
                        mark(key, "waiting")
                except PLAN_ERRORS as e:
                    mark(key, "failed", f"could not read the plan file: {e!r}")
        return 0
    state, since = load_state()
    coding = set(conf.get("coding_repos", []))
    runs = 0
    try:
        for key, entry in sorted((k, v) for k, v in state.items() if not k.startswith("_")):
            if only is not None and key not in only:
                continue
            if entry.get("blocked") or entry.get("closed") or (entry.get("analysis") or {}).get("decision") != "plan":
                continue
            if entry.get("stale_plan"):
                log(f"{key}: the approved plan is out of date; not coding until a new analysis")
                continue
            try:
                ap, units = approved_plan(entry)
            except PLAN_ERRORS as e:
                mark(key, "failed", f"could not read the plan file {entry.get('plan_file')}: {e!r}")
                continue
            if not ap:
                continue
            w = entry.get("work") or {}
            current = w.get("plan_digest") == ap["plan_digest"]
            if current and w.get("status") in ("pr-open", "blocked"):
                continue                    # waiting for step 5 or for Kenny
            repo, number = key.rsplit("#", 1)
            if repo not in coding:
                step = None if entry.get("coding_note") == ap["plan_digest"] else "note"
            elif current and w.get("status") == "in-progress":
                step = "interrupted"
            elif time.time() - entry.get("work_failed_at", 0) < RETRY_AFTER:
                step = None                 # the last try failed for a reason outside the plan (outage, setup)
                mark(key, "waiting")
            elif current and w.get("status") == "pushed":
                step = "pr"                 # pushed, but the PR wasn't finished: continue from the branch
            else:
                step = "code"
            if not step:
                continue
            if step == "code":
                busy = sum(1 for e in state.values() if isinstance(e, dict) and not e.get("blocked")
                           and (e.get("work") or {}).get("status") == "in-progress")
                if runs >= limit:
                    mark(key, "held", f"coding waits for the next pass (limit {limit})")
                    continue
                if busy >= IN_PROGRESS_LIMIT:     # other issues are being coded; that can take hours
                    mark(key, "waiting", f"coding waits until fewer than {IN_PROGRESS_LIMIT} issues are being coded")
                    continue
            try:
                issue = gh_json(["api", f"repos/{repo}/issues/{number}", "--jq",
                                 "{state, title, labels: [.labels[].name]}"])[0]
            except SystemExit:
                mark(key, "deferred", "could not read the issue; will retry")
                continue
            if issue["state"] != "open" or "bot:stop" in issue["labels"]:
                continue
            bot = WORKERS[entry["agent"]]
            if dry_run:
                log(f"{key}: would {step}")
                continue
            # Only "code" runs the coder and pushes. "interrupted" never resumes: it blocks the issue, and removing
            # bot:blocked clears the analysis, so the plan is analyzed again. "pr" opens the PR for a branch already
            # pushed; from then on feedback goes to the PR.
            if step == "code" and not plan_still_current(key, entry, QUEUE_DIR):
                continue                    # read again under work.lock: a newer comment or edit sends it back
            if step == "note":
                try:
                    run_gh_as(bot, repo, ["issue", "comment", number, "-R", repo, "--body",
                                          f"{W_MARKER}\nCoding isn't enabled for `{repo}`, so this approved plan "
                                          f"waits here. It is coded once the repository is in `coding_repos`."])
                    entry["coding_note"] = ap["plan_digest"]
                except RuntimeError as e:
                    mark(key, "failed", f"could not post the coding note, will retry: {e}")
                continue
            try:
                if step == "interrupted":
                    block(entry, bot, repo, number, issue["title"], f"{W_MARKER}\nCoding was interrupted before "
                          f"it finished (run `{w.get('run_id')}`).", "coding was interrupted")
                    continue
                if step == "pr":
                    finish_pr(key, entry, issue, state, since)
                    continue
                runs += 1
                SPENT["code"] += 1
                entry["work"] = {"status": "approved", "plan_digest": ap["plan_digest"], "approver": ap["approver"],
                                 "approved_at": ap["at"], "approval_comment": ap.get("comment", "")}
                code_plan(key, entry, issue, state, since, ecc)
            except (RuntimeError, subprocess.SubprocessError, SystemExit, OSError) as e:
                entry["work_failed_at"] = time.time()
                mark(key, "failed", f"{step} could not run; retrying in {RETRY_AFTER // 60} minutes: {e}")
    finally:
        if not dry_run:
            save_state(state, since)
        lock.close()
    log(f"coding pass done: {runs} run{'s' if runs != 1 else ''}")
    return 0


def cmd_tick():
    """The full scan: intake, then analysis, then 4a and 4b when switched on. Coding runs after tick.lock is
    released, under its own lock. After the scan, deferred queue files go back into their queues so the queue jobs
    check them again."""
    lock = work_lock("tick.lock")
    if lock is None:
        log("another tick is running; skipping this one")
        return 0
    try:
        cmd_intake()
        cmd_analyze()
        if read_config().get("approval_live"):   # step 4a joins the scheduled job only once switched on
            cmd_approve()
        requeue_deferred(QUEUE_DIR, QUEUE_DEFAULT)
        requeue_deferred(sibling(QUEUE_DIR, "code"), CODE_QUEUE_DEFAULT)
    finally:
        lock.close()
    if read_config().get("coding_live"):         # step 4b too, separately
        return cmd_code()
    return 0


# ---------- the event queues: tick --from-queue and code --from-queue ----------
# launchd's QueueDirectories relaunches a job while its folder has any entry at all, so nothing may stay there after
# a run: an issue's files are deleted once handled, moved to <queue>-deferred when it failed or waits (the hourly
# tick moves them back), and anything that can never be handled goes to <queue>-rejected, left for a person to clear.
# Issues held back only by a per-pass limit stay for the next run, a minute later. The issue queue does intake,
# analysis and approval; an issue that is ready to code is handed to the code queue, whose job runs the coding.
EVENTS_ROOT = Path.home() / ".local" / "state" / "github-events"
QUEUE_DEFAULT = EVENTS_ROOT / "iwb"
CODE_QUEUE_DEFAULT = EVENTS_ROOT / "iwb-code"
QUEUE_DIR = Path(os.environ.get("IWB_QUEUE_DIR", QUEUE_DEFAULT))
QUEUE_MARKER = ".github-events-queue"   # a regular file in a queue folder's parent: it holds event queues
QUEUE_MAX_ATTEMPTS = 24     # counted deferrals before an event file is rejected
REPO_NAME = re.compile(r"[A-Za-z0-9-]+/[A-Za-z0-9_.-]+")   # GitHub owners have no dots


def sibling(d, what):
    """<parent>/<name>-<what>: next to the queue folder, never inside it."""
    return d.parent / f"{d.name}-{what}"


def queue_dir_problem(d, default):
    """Why `d` must not be drained, or None. Accepted: the default folder, or a folder whose parent holds a regular
    QUEUE_MARKER file. Refused: a symlink, a file, anything else. A missing folder is fine: there is nothing in it."""
    if d.is_symlink():
        return f"{d} is a symlink"
    if not d.exists():
        return None
    if not d.is_dir():
        return f"{d} is not a directory"
    real = Path(os.path.realpath(d))
    if real == Path(os.path.realpath(default)):
        return None
    marker = real.parent / QUEUE_MARKER
    if marker.is_file() and not marker.is_symlink():
        return None
    return f"{d} is not {default}, and {real.parent} has no {QUEUE_MARKER} file marking it as an event queue"


def dest_problem(d):
    """Why `d` can't take moved or written events, or None: it must be absent or a real folder, never a symlink or a
    file (checked with lstat, so a link is never followed)."""
    try:
        st = os.lstat(d)
    except FileNotFoundError:
        return None
    if stat.S_ISLNK(st.st_mode):
        return f"{d} is a symlink"
    if not stat.S_ISDIR(st.st_mode):
        return f"{d} is not a directory"
    return None


def drain_problem(q, default):
    """queue_dir_problem for the queue, then dest_problem for its deferred and rejected folders."""
    for problem in (queue_dir_problem(q, default), dest_problem(sibling(q, "deferred")),
                    dest_problem(sibling(q, "rejected"))):
        if problem:
            return problem
    return None


def utc_stamp():
    t = time.time()
    return time.strftime("%Y%m%dT%H%M%S", time.gmtime(t)) + f"{int(t * 1000) % 1000:03d}Z"


def is_event_file(f):
    return f.name.endswith(".json") and not f.name.startswith(".") and f.is_file() and not f.is_symlink()


def free_name(dest, name):
    """dest/name, or dest/<stem>.<n><ext> when that is taken."""
    stem, ext = os.path.splitext(name)
    target, n = dest / name, 1
    while target.exists() or target.is_symlink():
        target, n = dest / f"{stem}.{n}{ext}", n + 1
    return target


def move_out(f, dest, why):
    """Move a queue entry by renaming it: a file, a folder with its contents, or a symlink as the link itself (a
    rename never follows it)."""
    dest.mkdir(parents=True, exist_ok=True)
    target = free_name(dest, f.name)
    os.replace(f, target)
    log(f"queue: {f.name}: {why}; moved to {target}")


def write_event(dest, name, ev, tmp_dir):
    """Write an event file into `dest` atomically: a temporary file in `tmp_dir` (same filesystem), then a rename."""
    for d in (dest, tmp_dir):
        problem = dest_problem(d)
        if problem:
            raise OSError(problem)
    tmp_dir.mkdir(parents=True, exist_ok=True)
    dest.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=tmp_dir, prefix=".", suffix=".tmp")
    try:
        with os.fdopen(fd, "w") as out:
            out.write(json.dumps(ev) + "\n")
        target = free_name(dest, name)
        os.replace(tmp, target)
    except BaseException:
        Path(tmp).unlink(missing_ok=True)
        raise
    return target


def defer(f, ev, deferred, rejected, why, count=True):
    """Move an event file to the deferred folder, written atomically. With `count` its "attempts" count goes up by
    one, and at QUEUE_MAX_ATTEMPTS it goes to the rejected folder instead; capacity waits pass count=False."""
    dest = deferred
    if count:
        n = ev.get("attempts")
        ev = {**ev, "attempts": (n if type(n) is int and n >= 0 else 0) + 1}
        if ev["attempts"] >= QUEUE_MAX_ATTEMPTS:
            dest = rejected
    target = write_event(dest, f.name, ev, dest)
    f.unlink(missing_ok=True)
    if dest == rejected:
        log(f"queue: {f.name}: {why}, attempt {ev['attempts']} of {QUEUE_MAX_ATTEMPTS}; gave up, moved to {target}")
    elif count:
        log(f"queue: {f.name}: {why}, attempt {ev['attempts']}; moved to {target} until the hourly tick")
    else:
        log(f"queue: {f.name}: {why}, not counted as an attempt; moved to {target} until the hourly tick")


def requeue_deferred(queue, default):
    """The hourly tick's part: put deferred event files back in the queue so the queue job retries them."""
    problem = drain_problem(queue, default)
    if problem:
        log(f"queue: not moving deferred events back: {problem}")
        return
    deferred = sibling(queue, "deferred")
    if not queue.is_dir() or not deferred.is_dir() or deferred.is_symlink():
        return
    moved = 0
    try:
        for f in sorted(deferred.iterdir()):
            if is_event_file(f):
                os.replace(f, free_name(queue, f.name))
                moved += 1
    except OSError as e:
        log(f"queue: could not move deferred events back: {e}")
    if moved:
        log(f"queue: {moved} deferred event file{'s' if moved != 1 else ''} moved back to {queue}")


def read_event(f):
    """The event as a dict, or None if it can never be handled (bad JSON, no valid repo or issue number). A sweep
    ({"kind": "sweep", "repo": "owner/name" or null}) has no number."""
    try:
        ev = json.loads(f.read_text())
        if isinstance(ev, dict) and ev.get("kind") == "sweep":
            repo = ev.get("repo")
            return ev if repo is None or isinstance(repo, str) and REPO_NAME.fullmatch(repo) else None
        repo, number = ev["repo"], ev["number"]
    except (ValueError, KeyError, TypeError, IndexError):
        return None
    if not isinstance(repo, str) or not REPO_NAME.fullmatch(repo) or type(number) is not int or number < 1:
        return None
    return ev


def queue_events(q, rejected):
    """[(file, event)] from the queue folder, oldest first. Every other entry goes to `rejected` by renaming the
    entry itself: other files, unreadable or invalid events, folders (moved whole, contents untouched) and
    symlinks (the link moves; its target is never followed or touched). Only call this on a folder that passed
    queue_dir_problem."""
    events = []
    for e in sorted(q.iterdir()):
        if e.is_symlink():
            move_out(e, rejected, "a symlink")
        elif e.is_dir():
            move_out(e, rejected, "a folder")
        elif not e.is_file():
            move_out(e, rejected, "not a regular file")
        elif not is_event_file(e):
            move_out(e, rejected, "not a .json event file")
        else:
            try:
                ev = read_event(e)
            except OSError as err:
                move_out(e, rejected, f"could not read ({err})")
                continue
            if ev is None:
                move_out(e, rejected, "not valid JSON with a repo and an issue number")
            else:
                events.append((e, ev))
    return events


def refuse(problem):
    print(f"iwb: refusing to drain the queue: {problem}", file=sys.stderr, flush=True)
    return 2


def settle(groups, deferred, rejected, what):
    """Act on each grouped issue's OUTCOME: delete (handled), leave (held), or defer. Exits 1 if one failed."""
    if groups and all(OUTCOME.get(k) == "held" for k in groups):
        # Can't happen with a fresh budget, but a run that only holds files back would leave the queue as it was
        # and launchd would start it again forever; defer instead.
        log(f"{what}: every issue was held by a limit; deferring them")
        OUTCOME.update(dict.fromkeys(groups, "waiting"))
    why = {"failed": "failed", "deferred": "will retry later", "waiting": "waits for capacity, a pause or a delay"}
    for key, fs in groups.items():
        outcome = OUTCOME.get(key)
        for f, ev in fs:
            if outcome is None:
                f.unlink(missing_ok=True)
            elif outcome == "rejected":
                move_out(f, rejected, f"{key} can't be handled here")
            elif outcome != "held":       # held: only a per-pass limit, stays in the queue for the next run
                defer(f, ev, deferred, rejected, why[outcome], count=outcome != "waiting")
    by = {o: sorted(k for k in groups if OUTCOME.get(k) == o)
          for o in ("failed", "deferred", "waiting", "held", "rejected")}
    done = sum(1 for k in groups if k not in OUTCOME)
    log(f"{what} pass done: {done} issue{'s' if done != 1 else ''} handled"
        + "".join(f"; {o}: {', '.join(ks)}" for o, ks in by.items() if ks))
    return 1 if by["failed"] else 0


def hand_off_to_coding(code_q, name, ev):
    """Write a coding hand-off for this issue into the code queue: the same event with "stage": "code"."""
    root = code_q.parent
    root.mkdir(parents=True, exist_ok=True)
    marker = root / QUEUE_MARKER
    if not marker.exists() and not marker.is_symlink():
        marker.touch()
    problem = queue_dir_problem(code_q, CODE_QUEUE_DEFAULT)
    if problem:
        raise OSError(problem)
    out = {k: v for k, v in ev.items() if k != "attempts"}
    out["stage"] = "code"
    return write_event(code_q, name, out, root / ".tmp")


def iso_now():
    t = time.time()
    return time.strftime("%Y-%m-%dT%H:%M:%S", time.gmtime(t)) + f".{int(t * 1000) % 1000:03d}Z"


def iwb_event(repo, number, event):
    """(file name, event) for an event iwb writes itself, in the router's format."""
    name = f"{utc_stamp()}-iwb-{repo.replace('/', '__')}-issue-{number}-{event}.json"
    return name, {"repo": repo, "kind": "issue", "number": int(number), "event": event, "received_at": iso_now(),
                  "source": "iwb", "version": 1}


def hand_off_ready(q, keys, handed):
    """Hand every issue in `keys` that is ready to code, has no outcome this run and wasn't handed off yet, to the
    code queue. `keys` maps a state key to the (file name, event) to send."""
    state = read_state_file()
    for key, (name, ev) in keys.items():
        if key in OUTCOME or key in handed:
            continue
        try:
            if not needs_coding(state.get(key)):
                continue
        except PLAN_ERRORS as e:
            mark(key, "failed", f"could not read the plan file: {e!r}")
            continue
        try:
            target = hand_off_to_coding(sibling(q, "code"), name, ev)
            handed.add(key)
            log(f"{key}: ready to code; handed to the code queue as {target}")
        except (OSError, ValueError) as e:
            mark(key, "failed", f"could not hand the issue to the code queue: {e}")


def sweep_pass(q, scope, groups, handed):
    """A sweep from the router: the hourly tick's intake, analysis and approval, for the repositories in `scope`
    (None: all of them), sharing what is left of this run's per-pass limits with the queued events; issues that
    are ready to code get hand-offs. Returns (ran, held): ran is True when nothing raised and every repository
    could be listed; held is True when a per-pass limit stopped some of its work, so the sweep stays queued for
    the next run. Per-issue failures inside the pass are left to those issues' own retries, as in the hourly
    tick, and never change the outcome of this run's queued events."""
    before = {k: OUTCOME.get(k) for k in groups}
    seen = set(OUTCOME)
    ok, listed = True, {}                 # listed: this sweep's own record of which repositories it could read
    try:
        for r in scope or [None]:
            cmd_intake(limit=LIMIT - SPENT["intake"], repo_filter=r, listed=listed)
            cmd_analyze(limit=ANALYZE_LIMIT - SPENT["analyze"], repo_filter=r)
            if read_config().get("approval_live"):
                cmd_approve(limit=APPROVE_LIMIT - SPENT["approve"], repo_filter=r)
    except (Exception, SystemExit) as e:
        ok = False
        log(f"queue: sweep failed: {e!r}")
    unlisted = [r for r in (scope or []) if not listed.get(r)] + [r for r, good in listed.items() if not good]
    if not listed and ok:
        unlisted = ["every repository"]   # nothing could be listed at all (no worker bot, nothing installed)
    unlisted = sorted(set(unlisted))
    if unlisted:
        ok = False
        log(f"queue: sweep could not list {', '.join(sorted(unlisted))}")
    if ok and read_config().get("coding_live"):
        state = read_state_file()
        ready = {k: iwb_event(*k.rsplit("#", 1), "sweep") for k in state
                 if "#" in k and k not in groups and (scope is None or k.rsplit("#", 1)[0] in scope)}
        hand_off_ready(q, ready, handed)
    held = any(v == "held" for k, v in OUTCOME.items() if k not in seen and k not in groups)
    for k, v in before.items():           # the sweep never changes what happens to this run's queued events
        if v is None:
            OUTCOME.pop(k, None)
        else:
            OUTCOME[k] = v
    return ok, held


def cmd_drain(queue_dir):
    """`tick --from-queue DIR`: intake, analysis and approval for each issue that has event files in DIR. Once a
    stage records an outcome for an issue (held, waiting, deferred, failed) the later stages skip it in this run.
    An issue that is ready to code is handed to the code queue (DIR-code). Sweep events (kind "sweep") run the
    full pass after the queued issues. Exits 1 if an issue or a sweep failed, 2 if DIR or its deferred or rejected
    folder can't be used."""
    q = Path(queue_dir).expanduser()
    problem = drain_problem(q, QUEUE_DEFAULT)
    if problem:
        return refuse(problem)
    entries = sorted(q.iterdir()) if q.is_dir() else []
    if not entries:
        return 0
    lock = work_lock("tick.lock")
    if lock is None:      # the other job is running and holds the lock; launchd starts this one again shortly
        log(f"queue: another tick is running; {len(entries)} entr{'ies' if len(entries) != 1 else 'y'} wait")
        return 0
    OUTCOME.clear()
    SPENT.update(dict.fromkeys(SPENT, 0))   # a fresh budget, so the first issue of every run is never limit-held
    deferred, rejected = sibling(q, "deferred"), sibling(q, "rejected")
    groups, sweeps, swept, sweep_held, paused = {}, [], True, False, False
    try:
        events = queue_events(q, rejected)
        if not events:
            return 0
        try:
            cfg = prbot.load_config()
            repos = {r.lower(): r for b in WORKERS.values() if b in cfg for r in prbot.installed_repos(b)}
        except (Exception, SystemExit) as e:
            log(f"queue: could not list the worker repositories: {e!r}")
            for f, ev in events:
                defer(f, ev, deferred, rejected, "worker repositories unknown")
            return 1
        for f, ev in events:
            if ev.get("kind") == "sweep":
                if ev.get("repo") is not None and ev["repo"].lower() not in repos:
                    move_out(f, rejected, f"sweep of {ev['repo']}, which is not a worker repository")
                else:
                    sweeps.append((f, ev))
            elif ev.get("kind") != "issue":
                move_out(f, rejected, "not an issue")
            elif ev["repo"].lower() not in repos:
                move_out(f, rejected, f"{ev['repo']} is not a worker repository")
            else:
                groups.setdefault(f"{repos[ev['repo'].lower()]}#{ev['number']}", []).append((f, ev))
        paused = read_config().get("paused")
        if paused:                        # nothing runs, and nothing is lost: everything waits for the unpause
            log("queue: paused in config.json; queued events wait in the deferred folder")
            OUTCOME.update(dict.fromkeys(groups, "waiting"))
        for key in [] if paused else groups:
            try:
                cmd_intake(limit=LIMIT - SPENT["intake"], only={key})
                if key not in OUTCOME:
                    cmd_analyze(limit=ANALYZE_LIMIT - SPENT["analyze"], only={key})
                if key not in OUTCOME and read_config().get("approval_live"):
                    cmd_approve(limit=APPROVE_LIMIT - SPENT["approve"], only={key})
            except (Exception, SystemExit) as e:
                mark(key, "failed", f"queued event failed: {e!r}")
        handed = set()
        if read_config().get("coding_live") and not paused:
            # the hand-off carries the installed repository's own name, which the state key uses
            hand_off_ready(q, {k: (fs[-1][0].name, {**fs[-1][1], "repo": k.rsplit("#", 1)[0]})
                               for k, fs in groups.items()}, handed)
        if sweeps and not paused:
            scope = None if any(ev.get("repo") is None for _, ev in sweeps) else \
                sorted({repos[ev["repo"].lower()] for _, ev in sweeps})
            log(f"queue: sweep of {', '.join(scope) if scope else 'every repository'}")
            swept, sweep_held = sweep_pass(q, scope, groups, handed)
            if swept and sweep_held:
                log("queue: the sweep hit a per-pass limit; it stays queued for the next run")
    finally:
        lock.close()
    rc = settle(groups, deferred, rejected, "queue")
    for f, ev in sweeps:
        if paused:
            defer(f, ev, deferred, rejected, "sweep waits for the unpause", count=False)
        elif not swept:
            defer(f, ev, deferred, rejected, "sweep failed")
        elif not sweep_held:              # held: left in the queue untouched, like a limit-held issue
            f.unlink(missing_ok=True)
    return 1 if sweeps and not swept else rc


def mark_plan_stale(key, why):
    """Record on the issue's state entry, under state.lock, that its approved plan is out of date. Approval and
    coding refuse such an entry on every path, and analysis treats it as needing a new analysis, which clears it."""
    state, since = load_state()
    entry = state.get(key)
    if not isinstance(entry, dict):
        return
    entry["stale_plan"] = {"at": time.time(), "reason": why}
    save_state(state, since)


def plan_still_current(key, entry, intake_q):
    """Read the issue again right before coding it. True: the approved plan is current, go ahead. False: don't code
    now. Either the issue couldn't be read (marked deferred), or the plan is out of date: then stale_plan is
    recorded under state.lock first, so no path approves or codes it until a new analysis, and an event goes
    back to the issue queue `intake_q`."""
    try:
        why = plan_is_stale(key, entry)
    except (Exception, SystemExit) as e:
        mark(key, "deferred", f"could not read the issue again before coding: {e!r}")
        return False
    if not why:
        return True
    if why == CLOSED:
        log(f"{key}: not coded: the issue was closed")
        return False                      # handled: nothing to code, nothing to send back
    try:
        mark_plan_stale(key, why)
    except (Exception, SystemExit) as e:
        mark(key, "failed", f"plan is out of date ({why}) but could not record that: {e!r}")
        return False
    try:
        problem = queue_dir_problem(intake_q, QUEUE_DEFAULT)
        if problem:
            raise OSError(problem)
        target = write_event(intake_q, *iwb_event(*key.rsplit("#", 1), "stale-plan"), intake_q.parent / ".tmp")
        log(f"{key}: not coded: the approved plan is out of date ({why}); sent back to {target}")
    except (OSError, ValueError) as e:
        mark(key, "failed", f"plan is out of date ({why}) but could not go back to the issue queue: {e}")
    return False


CLOSED = "issue closed"


def plan_is_stale(key, entry):
    """Why an approved plan must not be coded now, or None. Reads the issue and its comments again: an edit to the
    title or body, or a trusted comment after the analysis, means it needs analysis first (needs_analysis)."""
    cfg = prbot.load_config()
    owner = cfg[next(b for b in WORKERS.values() if b in cfg)]["owner"]
    bot_logins = {cfg[b]["slug"] + "[bot]" for b in WORKERS.values() if b in cfg}
    approver_logins = {cfg[b]["slug"] + "[bot]" for b in ("claude", "codex") if b in cfg}
    repo, number = key.rsplit("#", 1)
    trusted = trusted_openers(owner)
    issue, comments, _ = issue_text(repo, number, trusted, bot_logins, approver_logins)
    if issue["state"] != "open":
        return CLOSED                     # closed since cmd_code's first read: stop, never code it
    a = entry.get("analysis") or {}
    edited_at = last_edited(repo, number) if a and not a.get("digest") else None   # as cmd_analyze does
    return needs_analysis(copy.deepcopy(entry), comments, trusted, issue_digest(issue), edited_at)


def cmd_code_drain(queue_dir):
    """`code --from-queue DIR`: step 4b for each issue handed off in DIR by the issue queue. Same folders and
    outcomes: DIR-deferred, DIR-rejected; a coding lock held elsewhere is an uncounted wait. cmd_code reads the
    issue again under work.lock before coding; if it changed since its plan was analyzed, the plan is marked
    stale_plan, an event goes back to the issue queue (IWB_QUEUE_DIR), and the hand-off counts as handled."""
    q = Path(queue_dir).expanduser()
    problem = drain_problem(q, CODE_QUEUE_DEFAULT)
    if problem:
        return refuse(problem)
    entries = sorted(q.iterdir()) if q.is_dir() else []
    if not entries:
        return 0
    OUTCOME.clear()
    SPENT.update(dict.fromkeys(SPENT, 0))
    deferred, rejected = sibling(q, "deferred"), sibling(q, "rejected")
    groups = {}
    for f, ev in queue_events(q, rejected):
        if ev.get("kind") != "issue" or ev.get("stage") != "code":
            move_out(f, rejected, "not a coding hand-off")
        else:
            groups.setdefault(f"{ev['repo']}#{ev['number']}", []).append((f, ev))
    if not groups:
        return 0
    if read_config().get("paused"):       # before anything else: a pause never loses a hand-off
        log("code queue: paused in config.json; hand-offs wait in the deferred folder")
        OUTCOME.update(dict.fromkeys(groups, "waiting"))
        return settle(groups, deferred, rejected, "code queue")
    if not read_config().get("coding_live"):
        log("code queue: coding_live is off; hand-offs dropped")
        for fs in groups.values():
            for f, _ in fs:
                f.unlink(missing_ok=True)
        return 0
    for key in groups:
        try:                              # cmd_code reads the issue again under work.lock before coding it
            cmd_code(limit=CODE_LIMIT - SPENT["code"], only={key})
        except (Exception, SystemExit) as e:
            mark(key, "failed", f"coding hand-off failed: {e!r}")
    return settle(groups, deferred, rejected, "code queue")


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    if argv[0] == "intake":
        limit = int(argv[argv.index("--limit") + 1]) if "--limit" in argv else LIMIT
        return cmd_intake(dry_run="--dry-run" in argv, baseline="--baseline" in argv, limit=limit)
    if argv[0] == "analyze":
        limit = int(argv[argv.index("--limit") + 1]) if "--limit" in argv else ANALYZE_LIMIT
        return cmd_analyze(dry_run="--dry-run" in argv, limit=limit)
    if argv[0] == "approve":
        return cmd_approve(dry_run="--dry-run" in argv)
    if argv[0] == "code":
        if "--from-queue" in argv:
            i = argv.index("--from-queue") + 1
            if i >= len(argv) or argv[i].startswith("-"):
                prbot.die("code --from-queue needs the queue folder")
            return cmd_code_drain(argv[i])
        return cmd_code(dry_run="--dry-run" in argv)
    if argv[0] == "tick":   # what launchd runs: pick up new issues, then analyze one
        if "--from-queue" in argv:
            i = argv.index("--from-queue") + 1
            if i >= len(argv) or argv[i].startswith("-"):
                prbot.die("tick --from-queue needs the queue folder")
            return cmd_drain(argv[i])
        return cmd_tick()
    prbot.die(f"unknown command '{argv[0]}'")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
